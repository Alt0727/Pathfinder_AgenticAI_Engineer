{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./**/.env)",
      "Read(./**/.env.local)",
      "Read(./**/.env.*.local)",
      "Read(./apps/listener/auth/**)",
      "Edit(./**/.env)",
      "Edit(./**/.env.local)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git add -A:*)",
      "Bash(git add .:*)"
    ]
  }
}
