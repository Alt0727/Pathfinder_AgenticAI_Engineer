{
 "description": "AI #1 accuracy set for unmute. 50 messages from 9 fake campus groups, Mon 26 Oct to Thu 29 Oct 2026 (IST). 20 relevant, 30 chatter. Includes relative dates, a repeat reminder, an extension, a cancellation, a postponement, a forward, a civic notice and a prompt-injection attempt.",
 "how_to_run": [
  "Run every message through prefilter.js then redact.js first, exactly like the listener. A message the prefilter drops counts as decision relevant:false.",
  "Feed the surviving messages to the extractor in chronological order, in batches of up to 20 (dry run: no DB writes). Keep an in-memory card list so update/cancel ops can match cards created earlier in the run.",
  "When the AI creates a card, map its id to the `ref` of the matching expected create op (same message, same type). Update/cancel ops are checked against that ref.",
  "Report: prefilter drop count (and any RELEVANT message it wrongly dropped: must be 0), relevance %, type %, date %, update/cancel %."
 ],
 "scoring": {
  "relevance": "expected.relevant vs AI decision, all 50 messages",
  "type": "for each expected create op: AI created a card of the same type from that message",
  "dates": "deadline_at / starts_at / ends_at must match to the minute when expected is non-null; null expected = AI must leave it null",
  "ops": "update/cancel ops: AI targeted the card mapped to `ref`; for updates, the listed fields changed to the expected values",
  "prefilter": "No message with expected.relevant=true may be dropped by the prefilter. Count how many chatter messages it removed on its own."
 },
 "date_rules_tested": [
  "Relative dates resolve against sent_at, not the current time",
  "A date with no time, 'midnight on X' and 'tonight' with no time = 23:59",
  "ends_at only when a range or end is stated"
 ],
